# ─────────────────────────────────────────
#  wolfXtg Bot — Environment Variables
# ─────────────────────────────────────────

# Required — get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional — Tenor GIF API key (a default is built-in, but you can use your own)
# Get a free key at: https://developers.google.com/tenor/guides/quickstart
TENOR_API_KEY=your_tenor_api_key_here
